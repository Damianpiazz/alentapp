// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client-js"
    output   = "../src/generated/client"
}

datasource db {
    provider = "postgresql"
}

enum MemberCategory {
    Pleno
    Cadete
    Honorario
}

enum MemberStatus {
    Activo
    Moroso
    Suspendido
}

model Member {
    id         String         @id @default(uuid())
    dni        String         @unique
    name       String
    email      String         @unique
    birthdate  DateTime?      @db.Date
    category   MemberCategory
    status     MemberStatus   @default(Activo)
    created_at DateTime       @default(now())
    disciplines Discipline[]

    payments Payment[] //relacion con payments

    @@map("members") // Para que en la DB la tabla se llame 'members' en minúscula
}

enum PaymentStatus {
    Pending
    Paid
    Canceled
    Overdue
}

model Payment {
    id           String    @id @default(uuid())
    amount       Float
    month        Int
    year         Int
    status       PaymentStatus    @default(Pending)
    due_date     DateTime
    payment_date DateTime?
    deleted_at   DateTime?
  
    // Relación con el Socio (Member)
    member_id    String
    member       Member    @relation(fields: [member_id], references: [id])

    @@map("payments")
}
model Discipline {
    id                  String   @id @default(uuid())
    member_id           String
    reason              String
    start_date          DateTime @db.Date
    end_date            DateTime @db.Date
    is_total_suspension Boolean  @default(false)
    created_at          DateTime @default(now())

    member Member @relation(fields: [member_id], references: [id])

    @@index([member_id])
    
    @@map("disciplines")
}
