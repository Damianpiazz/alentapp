// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client-js"
    output   = "../src/generated/client"
}

datasource db {
    provider = "postgresql"
}

enum MemberCategory {
    Pleno
    Cadete
    Honorario
}

enum MemberStatus {
    Activo
    Moroso
    Suspendido
}

model Member {
    id         String         @id @default(uuid())
    dni        String         @unique
    name       String
    email      String         @unique
    birthdate  DateTime?      @db.Date
    category   MemberCategory
    status     MemberStatus   @default(Activo)
    created_at DateTime       @default(now())

    @@map("members") // Para que en la DB la tabla se llame 'members' en minúscula
}

model Locker {
  id                    String   @id @default(uuid())
  number                String   @unique
  location              LockerLocation
  status                LockerStatus @default(DISPONIBLE)

  member_id             String?
  contract_finish_date  DateTime?
  contract_start_date   DateTime @default(now())
}

enum LockerLocation {
  VESTUARIO_MASCULINO
  VESTUARIO_FEMENINO
  NINOS
}

enum LockerStatus {
  DISPONIBLE
  OCUPADO
  MANTENIMIENTO
}