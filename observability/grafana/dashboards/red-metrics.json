{
    "title": "RED — Alentapp API",
    "uid": "red-alentapp-api",
    "schemaVersion": 39,
    "version": 2,
    "timezone": "browser",
    "panels": [
        {
            "id": 1,
            "title": "Requests por segundo",
            "type": "timeseries",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
            "targets": [
                {
                    "expr": "rate(http_requests_total[1m])",
                    "legendFormat": "{{method}} {{route}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "cps", "min": 0 },
                "overrides": []
            }
        },
        {
            "id": 2,
            "title": "Tasa de error (%)",
            "type": "timeseries",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
            "targets": [
                {
                    "expr": "sum(rate(http_requests_errors[1m])) / sum(rate(http_requests_total[1m])) * 100",
                    "legendFormat": "Error %",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "percent", "min": 0, "max": 100 },
                "overrides": []
            }
        },
        {
            "id": 3,
            "title": "Latencia p95 / p99",
            "type": "timeseries",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_bucket[5m])) by (le))",
                    "legendFormat": "p95",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_bucket[5m])) by (le))",
                    "legendFormat": "p99",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "ms" },
                "overrides": []
            }
        },
        {
            "id": 4,
            "title": "Requests activos",
            "type": "timeseries",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
            "targets": [
                {
                    "expr": "http_requests_active",
                    "legendFormat": "{{method}} {{route}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "short", "min": 0 },
                "overrides": []
            }
        },
        {
            "id": 5,
            "title": "Distribución por status code",
            "type": "timeseries",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
            "targets": [
                {
                    "expr": "sum by(status) (rate(http_requests_total[5m]))",
                    "legendFormat": "{{status}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "cps" },
                "overrides": []
            },
            "stacking": { "mode": "normal" },
            "fillOpacity": 50
        },
        {
            "id": 6,
            "title": "Memoria del proceso",
            "type": "timeseries",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
            "targets": [
                {
                    "expr": "process_memory_usage / 1024 / 1024",
                    "legendFormat": "Heap used",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "MB" },
                "overrides": []
            }
        },
        {
            "id": 7,
            "title": "Endpoints más lentos (top 5)",
            "type": "bargauge",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
            "targets": [
                {
                    "expr": "topk(5, avg by(route) (rate(http_request_duration_sum[5m]) / rate(http_request_duration_count[5m])))",
                    "legendFormat": "{{route}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "ms", "min": 0 },
                "overrides": []
            },
            "orientation": "horizontal"
        }
    ],
    "refresh": "30s",
    "time": { "from": "now-15m", "to": "now" },
    "tags": ["alentapp", "api", "red"],
    "editable": true
}
